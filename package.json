{
  "name": "geshang_frame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "type-check": "tsc --build --force",
    "type-check:app": "tsc -p tsconfig.app.json --noEmit",
    "type-check:node": "tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --ext .ts,.vue --fix --max-warnings 0",
    "format": "prettier --write .",
    "prepare": "npm run lint && npm run type-check",
    "postinstall": "husky install",
    "lint:css": "stylelint \"**/*.{css,scss,vue}\"",
    "lint:css:fix": "stylelint \"**/*.{css,scss,vue}\" --fix"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,vue}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "vite.config.ts": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ],
    "*.{css,scss,sass,less}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "element-plus": "^2.10.5",
    "sass": "^1.89.2",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@iconify-json/mdi": "^1.2.3",
    "@stylelint/postcss-css-in-js": "^0.38.0",
    "@stylistic/stylelint-plugin": "^4.0.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.2.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitejs/plugin-vue-jsx": "^5.0.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "husky": "^8.0.0",
    "jiti": "^2.5.1",
    "lint-staged": "^16.1.4",
    "postcss": "^8.4.45",
    "postcss-html": "^1.7.0",
    "postcss-scss": "^4.0.9",
    "postcss-syntax": "^0.36.2",
    "prettier": "^3.6.2",
    "stylelint": "^16.9.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recess-order": "^7.1.0",
    "stylelint-config-recommended-scss": "^15.0.1",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-order": "^6.0.4",
    "stylelint-scss": "^6.12.1",
    "typescript": "~5.8.3",
    "unocss": "^66.4.1",
    "unplugin-auto-import": "^20.0.0",
    "unplugin-icons": "^22.2.0",
    "unplugin-vue-components": "^28.8.0",
    "unplugin-vue-setup-extend-plus": "^1.0.1",
    "vite": "^7.0.4",
    "vite-plugin-checker": "^0.10.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.2.12"
  }
}
