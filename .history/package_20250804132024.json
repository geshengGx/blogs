{
  "name": "geshang_frame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "type-check": "tsc --build --force",
    "type-check:app": "tsc -p tsconfig.app.json --noEmit",
    "type-check:node": "tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --ext .ts,.vue --fix --max-warnings 0",
    "format": "prettier --write .",
    "prepare": "npm run lint && npm run type-check",
    "postinstall": "husky install"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,vue}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "vite.config.ts": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "sass": "^1.89.2",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-vue": "^10.4.0",
    "husky": "^8.0.0",
    "lint-staged": "^16.1.4",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vue-tsc": "^2.2.12"
  }
}
