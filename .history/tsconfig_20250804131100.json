{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "target": "ESNext",                 // 编译目标ES版本
    "module": "ESNext",                 // 模块系统
    "moduleResolution": "node",         // 模块解析策略
    "strict": true,                     // 启用所有严格类型检查
    "jsx": "preserve",                  // 保留JSX语法（Vue JSX）
    "sourceMap": true,                  // 生成source map
    "resolveJsonModule": true,          // 允许导入JSON文件
    "esModuleInterop": true,            // 兼容CommonJS和ES模块
    "lib": ["ESNext", "DOM", "DOM.Iterable"], // 包含的库声明
    "skipLibCheck": true,               // 跳过声明文件类型检查
    "types": ["vite/client"],           // 包含Vite客户端类型
    
    // 路径别名配置（与vite.config.ts保持一致）
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "exclude": ["node_modules", "dist"]
}
