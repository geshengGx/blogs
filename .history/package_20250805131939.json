{
  "name": "geshang_frame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "type-check": "tsc --build --force",
    "type-check:app": "tsc -p tsconfig.app.json --noEmit",
    "type-check:node": "tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --ext .ts,.vue --fix --max-warnings 0",
    "format": "prettier --write .",
    "prepare": "npm run lint && npm run type-check",
    "postinstall": "husky install",
    "lint:css": "stylelint \"**/*.{css,scss,vue}\"",
    "lint:css:fix": "stylelint \"**/*.{css,scss,vue}\" --fix"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,vue}": ["eslint --fix --max-warnings 0", "prettier --write"],
    "vite.config.ts": ["eslint --fix --max-warnings 0", "prettier --write"],
    "*.{json,md,yaml,yml}": ["prettier --write"],
    "*.{css,scss,sass,less}": ["stylelint --fix", "prettier --write"]
  },
  "dependencies": {
    "sass": "^1.89.2",
    "unplugin-icons": "^22.2.0",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@stylelint/postcss-css-in-js": "^0.38.0",
    "@stylistic/stylelint-plugin": "^4.0.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "husky": "^8.0.0",
    "jiti": "^2.5.1",
    "lint-staged": "^16.1.4",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "postcss-syntax": "^0.36.2",
    "prettier": "^3.6.2",
    "stylelint": "^16.23.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recommended-scss": "^15.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-scss": "^6.12.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-checker": "^0.10.2",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.2.12"
  }
}
