{
  // 继承基础配置（如果有）
  // "extends": "./tsconfig.base.json",

  "compilerOptions": {
    // "composite": true,
    // 允许编译JavaScript文件 - 常见需求
    "allowJs": true,
    // 编译目标 - 最新的ECMAScript标准
    "target": "ESNext",

    // 模块系统 - ESM模块
    "module": "ESNext",

    // 模块解析策略 - Node风格
    "moduleResolution": "bundler",

    // 允许导入JSON文件 - 常见需求
    "resolveJsonModule": true,

    // 启用隔离模块 - 对Vite很重要
    "isolatedModules": true,

    // 改进CommonJS和ES模块互操作
    "esModuleInterop": true,

    // 包含的库声明 - 浏览器环境
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // 包含的全局类型声明
    "types": ["vite/client", "unplugin-icons/types/vue", "element-plus/global"],

    // === 代码质量增强 ===
    // 检查未使用的局部变量
    "noUnusedLocals": true,

    // 检查未使用的函数参数
    "noUnusedParameters": true,

    // 检查switch语句是否完整
    "noFallthroughCasesInSwitch": true,

    // 确保函数所有路径都有返回值
    "noImplicitReturns": true,

    // === 路径别名配置 ===
    // 基础路径
    "baseUrl": ".",

    // 路径映射 - 简化导入
    "paths": {
      "@/*": ["src/*"], // src目录别名
      "@components/*": ["src/components/*"],
      "@assets/*": ["src/assets/*"],
      "#/*": ["types/*"]
    }
  },

  // 包含的文件 - 前端应用代码
  "include": [
    "src/**/*.ts", // 所有TypeScript文件
    "src/**/*.d.ts", // 类型声明文件
    "src/**/*.tsx", // TSX文件（如使用JSX）
    "src/**/*.vue", // Vue单文件组件
    "src/types/**/*.d.ts", // 全局类型声明
    "env.d.ts", // Vite环境声明
    "auto-imports.d.ts",
    "components.d.ts"
  ],

  // 排除的文件
  "exclude": [
    "node_modules", // 依赖目录
    "dist", // 构建输出
    "**/*.spec.ts", // 测试文件（如果存在）
    "**/*.test.ts" // 测试文件
  ]
}
