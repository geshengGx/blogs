{
  // 继承基础配置（如果有）
  // "extends": "./tsconfig.base.json",

  "compilerOptions": {
    // 标记为复合项目 - 启用项目引用功能
    "composite": true,

    // 模块系统
    "module": "ESNext",

    // 模块解析策略
    "moduleResolution": "bundler",

    // Node.js环境类型
    "types": ["node"],

    // === 严格模式增强 ===
    // 启用严格的null检查
    "strictNullChecks": true,

    // 启用严格的函数类型检查
    "strictFunctionTypes": true,

    // 允许使用import动态导入
    "allowSyntheticDefaultImports": true,

    // 禁用隐式的any类型
    "noImplicitAny": true,
    // 添加基础路径和路径映射
    "baseUrl": ".",
    "paths": {
      "#/*": ["src/types/*"]
    }
  },

  // 包含的文件 - Node环境代码
  "include": [
    "vite.config.ts", // Vite主配置
    "vitest.config.ts", // 测试配置（如果使用）
    "scripts/**/*", // 构建脚本
    "build/**/*.ts", // 构建相关
    "mock/**/*.ts", // Mock数据
    "postcss.config.js", // PostCSS配置（转成TS）
    "tailwind.config.js", // Tailwind配置（转成TS）
    "src/types/**/*.d.ts" // 添加全局类型声明文件
  ],

  // 排除的文件
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*" // 排除前端代码
  ]
}
